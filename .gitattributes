# Keep the Maven wrapper scripts runnable on every OS, whatever the local autocrlf setting
mvnw text eol=lf
*.cmd text eol=crlf
# Development scripts (scripts/): bash needs LF, cmd.exe needs CRLF to find the labels
*.sh text eol=lf
*.bat text eol=crlf
# jpackage scripts run on Linux and macOS
packaging/linux*/postinst text eol=lf
packaging/linux*/prerm text eol=lf
packaging/linux*/*.spec text eol=lf
packaging/macos-cli/postinstall text eol=lf
