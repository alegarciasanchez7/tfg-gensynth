<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.gensynth</groupId>
    <artifactId>core</artifactId>
    <version>0.5.2</version>
    <packaging>jar</packaging>

    <name>Gen-Synth Core</name>
    <description>Gen-Synth Core Module</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <benchmark.mainClass>com.gensynth.core.flow.variables.config.VariableConfigBenchmark</benchmark.mainClass>
        <jacoco.version>0.8.15</jacoco.version>
        <jline.version>3.30.17</jline.version>
        <!-- Installers (-Dinstaller): built with jpackage on the OS they target -->
        <installer.dir>${project.build.directory}/installer</installer.dir>
        <installer.input>${installer.dir}/input</installer.input>
        <installer.packaging>${project.basedir}/../packaging</installer.packaging>
        <!-- CLI edition: the gensynth command line alone, without the desktop window or JCEF -->
        <installer.cli.input>${installer.dir}/input-cli</installer.cli.input>
        <installer.cli.dist>${installer.dir}/dist-cli</installer.cli.dist>
        <installer.cli.name>GenSynth-CLI</installer.cli.name>
        <installer.cli.description>GenSynth command line: runs synthetic data projects (.gsynth) from a terminal, without the desktop window.</installer.cli.description>
        <!-- Skips the .rpm on Linux machines without rpmbuild (-Dinstaller.skipRpm=true) -->
        <installer.skipRpm>false</installer.skipRpm>
        <!-- Skips the .deb on Linux machines without dpkg-deb, such as Fedora (-Dinstaller.skipDeb=true) -->
        <installer.skipDeb>false</installer.skipDeb>
        <!-- jpackage rejects macOS versions that start with 0, so the app bundle declares this one
             while GenSynth is 0.x. From 1.0 on, set it back to ${project.version} -->
        <installer.macAppVersion>1.0.0</installer.macAppVersion>
        <!-- Skips the npm build and the UI copy (-DskipUi=true), for environments without Node such as GitLab CI -->
        <skipUi>false</skipUi>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Keeps every Jackson module on one version: otherwise pulsar-client imposes its own jackson-annotations -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.18.6</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Contract implemented by connector plugins (shared with external plugin JARs) -->
        <dependency>
            <groupId>com.gensynth</groupId>
            <artifactId>gensynth-plugin-api</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- JUnit for testing -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Shared Libraries (Provided at runtime by the core/lib/shared folder) -->
        <!-- These are NOT bundled in the core.jar to keep it slim and secure -->
        
        <!-- MQTT -->
        <dependency>
            <groupId>org.eclipse.paho</groupId>
            <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
            <version>1.2.5</version>
            <scope>provided</scope>
        </dependency>

        <!-- Kafka -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>3.9.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- RabbitMQ: the connector is included in the application, like File Output, so it and
             its client library are on the classpath (external plugins see them too) -->
        <dependency>
            <groupId>com.rabbitmq</groupId>
            <artifactId>amqp-client</artifactId>
            <version>5.18.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.gensynth.plugins</groupId>
            <artifactId>rabbitmq-connector</artifactId>
            <version>1.0.0</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ActiveMQ -->
        <dependency>
            <groupId>org.apache.activemq</groupId>
            <artifactId>activemq-client</artifactId>
            <version>6.2.5</version>
            <scope>provided</scope>
        </dependency>

        <!-- Pulsar -->
        <dependency>
            <groupId>org.apache.pulsar</groupId>
            <artifactId>pulsar-client</artifactId>
            <version>4.0.10</version>
            <scope>provided</scope>
        </dependency>

        <!-- NATS -->
        <dependency>
            <groupId>io.nats</groupId>
            <artifactId>jnats</artifactId>
            <version>2.25.2</version>
            <scope>provided</scope>
        </dependency>

        <!-- Redis (Jedis) -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>7.2.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- WebSocket server -->
        <dependency>
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
            <version>1.5.4</version>
        </dependency>

        <!-- YAML Configuration -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.2</version>
        </dependency>

        <!-- JSON Configuration -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Logging Implementation -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>1.7.36</version>
        </dependency>

        <!-- Line editing of the command line: Tab completion and history (see TerminalInput) -->
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline-reader</artifactId>
            <version>${jline.version}</version>
        </dependency>
        <!-- Native terminal access (bundles the libraries for Windows, macOS and Linux) -->
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline-terminal-jni</artifactId>
            <version>${jline.version}</version>
        </dependency>

        <!-- Data Faker -->
        <dependency>
            <groupId>net.datafaker</groupId>
            <artifactId>datafaker</artifactId>
            <version>2.0.2</version>
        </dependency>

        <!-- Math Expressions -->
        <dependency>
            <groupId>net.objecthunter</groupId>
            <artifactId>exp4j</artifactId>
            <version>0.4.8</version>
        </dependency>

        <!-- Regex string generator -->
        <dependency>
            <groupId>com.github.curious-odd-man</groupId>
            <artifactId>rgxgen</artifactId>
            <version>1.4</version>
        </dependency>

        <!-- ASM for bytecode analysis (plugin security validation) -->
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>9.7</version>
        </dependency>

        <!-- Multiplatform JCEF Support -->
        <dependency>
            <groupId>me.friwi</groupId>
            <artifactId>jcefmaven</artifactId>
            <version>146.0.10</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- Copied as is: the UI bundle may contain ${...} that must not be replaced -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <!-- Filtered: gensynth-version.properties gets the project version -->
            <resource>
                <directory>src/main/resources-filtered</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- 1. Build React UI -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <skip>${skipUi}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>npm-install</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>npm</executable>
                            <arguments><argument>install</argument></arguments>
                            <workingDirectory>../ui</workingDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>npm</executable>
                            <arguments><argument>run</argument><argument>build</argument></arguments>
                            <workingDirectory>../ui</workingDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 2. Copy UI to resources (Using Antrun to avoid 'outside base directory' warnings) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <skip>${skipUi}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>copy-ui-resources</id>
                        <phase>generate-resources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <echo message="Copying UI distribution from ui/dist to core resources..." />
                                <!-- Start clean so hashed bundles from previous builds do not pile up in the JAR -->
                                <delete dir="${project.basedir}/src/main/resources/ui" />
                                <mkdir dir="${project.basedir}/src/main/resources/ui" />
                                <copy todir="${project.basedir}/src/main/resources/ui">
                                    <fileset dir="${project.basedir}/../ui/dist" />
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-shared-libs</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/lib/shared</outputDirectory>
                            <includeScope>provided</includeScope>
                            <!-- Only copy the libraries we want to share with plugins (amqp-client is already on
                                 the application classpath, which external plugins also see) -->
                            <includeArtifactIds>
                                kafka-clients,org.eclipse.paho.client.mqttv3,activemq-client,pulsar-client,jnats,jedis
                            </includeArtifactIds>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>false</overWriteSnapshots>
                            <overWriteIfNewer>true</overWriteIfNewer>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/dependency</outputDirectory>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>false</overWriteSnapshots>
                            <overWriteIfNewer>true</overWriteIfNewer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Test coverage report (target/site/jacoco/jacoco.xml), consumed by SonarQube -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <!-- This is to avoid Eclipse M2E warnings about exec-maven-plugin -->
                <plugin>
                    <groupId>org.eclipse.m2e</groupId>
                    <artifactId>lifecycle-mapping</artifactId>
                    <version>1.0.0</version>
                    <configuration>
                        <lifecycleMappingMetadata>
                            <pluginExecutions>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>org.codehaus.mojo</groupId>
                                        <artifactId>exec-maven-plugin</artifactId>
                                        <versionRange>[3.5.0,)</versionRange>
                                        <goals><goal>exec</goal></goals>
                                    </pluginExecutionFilter>
                                    <action><ignore/></action>
                                </pluginExecution>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>org.apache.maven.plugins</groupId>
                                        <artifactId>maven-antrun-plugin</artifactId>
                                        <versionRange>[3.1.0,)</versionRange>
                                        <goals><goal>run</goal></goals>
                                    </pluginExecutionFilter>
                                    <action><ignore/></action>
                                </pluginExecution>
                                <!-- The IDE resolves plugin-api as a workspace project (no JAR), which copy-dependencies
                                     cannot copy (MDEP-187). The copies are only needed by the command-line build. -->
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>org.apache.maven.plugins</groupId>
                                        <artifactId>maven-dependency-plugin</artifactId>
                                        <versionRange>[3.6.1,)</versionRange>
                                        <goals><goal>copy-dependencies</goal></goals>
                                    </pluginExecutionFilter>
                                    <action><ignore/></action>
                                </pluginExecution>
                            </pluginExecutions>
                        </lifecycleMappingMetadata>
                    </configuration>
                </plugin>
                <!-- Settings shared by the installers of every OS (see the installer-* profiles) -->
                <plugin>
                    <groupId>org.panteleyev</groupId>
                    <artifactId>jpackage-maven-plugin</artifactId>
                    <version>1.8.0</version>
                    <configuration>
                        <name>GenSynth</name>
                        <appVersion>${project.version}</appVersion>
                        <vendor>Alejandro Garcia Sanchez</vendor>
                        <copyright>Copyright 2026 Alejandro Garcia Sanchez</copyright>
                        <description>Synthetic data generator for IoT and messaging systems. The first start downloads the embedded browser (about 150 MB) and needs an internet connection.</description>
                        <aboutUrl>https://github.com/alegarciasanchez7/tfg-gensynth</aboutUrl>
                        <input>${installer.input}</input>
                        <!-- Installed next to $APPDIR, outside the classpath: only the plugins load them -->
                        <appContentPaths>
                            <appContentPath>${installer.dir}/shared</appContentPath>
                        </appContentPaths>
                        <mainJar>${project.build.finalName}.jar</mainJar>
                        <mainClass>com.gensynth.core.App</mainClass>
                        <destination>${installer.dir}/dist</destination>
                        <!-- Default arguments of the launcher: passing any argument replaces them -->
                        <arguments>
                            <argument>--desktop</argument>
                        </arguments>
                        <!-- $APPDIR is expanded by the launcher: the folder of the installed application files -->
                        <javaOptions>
                            <option>-Dgensynth.appdir=$APPDIR</option>
                        </javaOptions>
                        <!-- Second launcher: the "gensynth" command line (headless shell, see CliMain) -->
                        <launchers>
                            <launcher>
                                <name>gensynth-cli</name>
                                <file>${installer.packaging}/launchers/gensynth-cli.properties</file>
                            </launcher>
                        </launchers>
                        <!-- Double clicking a .gsynth file opens it in the application -->
                        <fileAssociations>
                            <fileAssociation>${installer.packaging}/associations/gsynth.properties</fileAssociation>
                        </fileAssociations>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>


    <profiles>
        <!--
          Local static analysis without a server (scripts/unix/analyze.sh, scripts\windows\analyze.bat):
          ./mvnw -Pcode-analysis verify. SpotBugs (target/reports/spotbugs.html), PMD (target/reports/pmd.html)
          and CPD, duplicated code (target/reports/cpd.html). Findings are reported, never fail the build.
        -->
        <profile>
            <id>code-analysis</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>4.10.5.0</version>
                        <configuration>
                            <effort>Max</effort>
                            <threshold>Medium</threshold>
                            <xmlOutput>true</xmlOutput>
                            <htmlOutput>true</htmlOutput>
                            <failOnError>false</failOnError>
                        </configuration>
                        <executions>
                            <execution>
                                <id>spotbugs</id>
                                <phase>verify</phase>
                                <goals><goal>spotbugs</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-pmd-plugin</artifactId>
                        <version>3.28.0</version>
                        <configuration>
                            <rulesets>
                                <ruleset>/rulesets/java/quickstart.xml</ruleset>
                            </rulesets>
                            <linkXRef>false</linkXRef>
                            <printFailingErrors>false</printFailingErrors>
                            <failOnViolation>false</failOnViolation>
                        </configuration>
                        <executions>
                            <execution>
                                <id>pmd</id>
                                <phase>verify</phase>
                                <goals><goal>pmd</goal><goal>cpd</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>benchmark</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <configuration>
                            <mainClass>${benchmark.mainClass}</mainClass>
                            <classpathScope>test</classpathScope>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Installers: ./mvnw -B -Dinstaller -DskipTests package (from the root, on the target OS).
          This profile gathers the application files in target/installer/input; the installer-<os>
          profile of the running OS turns them into an installer in target/installer/dist.
          Besides the GenSynth launcher, every installer ships the gensynth-cli launcher (command line).
          Each installer-<os> profile also builds the CLI edition in target/installer/dist-cli: the
          command line alone (CliMain as the main launcher, started with -Dgensynth.edition=cli), from
          target/installer/input-cli, which has no JCEF libraries. Its executions repeat the same
          overrides of the shared settings: other name, input, main class and destination, and no
          default arguments, second launcher or file association.
        -->
        <profile>
            <id>installer</id>
            <activation>
                <property><name>installer</name></property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>installer-dependencies</id>
                                <phase>package</phase>
                                <goals><goal>copy-dependencies</goal></goals>
                                <configuration>
                                    <outputDirectory>${installer.input}</outputDirectory>
                                    <!-- Only what the application needs at runtime: no test or provided libraries -->
                                    <includeScope>runtime</includeScope>
                                </configuration>
                            </execution>
                            <execution>
                                <id>installer-cli-dependencies</id>
                                <phase>package</phase>
                                <goals><goal>copy-dependencies</goal></goals>
                                <configuration>
                                    <outputDirectory>${installer.cli.input}</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                    <!-- The CLI edition has no desktop window: no JCEF, JOGL or GlueGen -->
                                    <excludeGroupIds>me.friwi</excludeGroupIds>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>installer-input</id>
                                <phase>package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <skip>false</skip>
                                    <target>
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar" todir="${installer.input}"/>
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar" todir="${installer.cli.input}"/>
                                        <!-- Client libraries shared with the plugins: app content, not on the classpath -->
                                        <copy todir="${installer.dir}/shared">
                                            <fileset dir="${project.basedir}/lib/shared" includes="*.jar"/>
                                        </copy>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>installer-windows</id>
            <activation>
                <property><name>installer</name></property>
                <os><family>windows</family></os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>installer-msi</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <type>MSI</type>
                                    <icon>${installer.packaging}/icons/gensynth.ico</icon>
                                    <winMenu>true</winMenu>
                                    <winMenuGroup>GenSynth</winMenuGroup>
                                    <winShortcut>true</winShortcut>
                                    <winDirChooser>true</winDirChooser>
                                    <!-- Fixed forever: lets a newer version replace the installed one -->
                                    <winUpgradeUuid>5c2b9d1e-7f4a-4c3e-9b8d-2e6f1a0c4d73</winUpgradeUuid>
                                    <!-- cli\gensynth.cmd: the folder users add to PATH to type "gensynth" -->
                                    <appContentPaths combine.children="append">
                                        <appContentPath>${installer.packaging}/windows/cli</appContentPath>
                                    </appContentPaths>
                                </configuration>
                            </execution>
                            <execution>
                                <id>installer-cli-msi</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <type>MSI</type>
                                    <name>${installer.cli.name}</name>
                                    <description>${installer.cli.description}</description>
                                    <input>${installer.cli.input}</input>
                                    <mainClass>com.gensynth.core.cli.CliMain</mainClass>
                                    <destination>${installer.cli.dist}</destination>
                                    <arguments combine.self="override"/>
                                    <launchers combine.self="override"/>
                                    <fileAssociations combine.self="override"/>
                                    <javaOptions combine.children="append">
                                        <option>-Dgensynth.edition=cli</option>
                                    </javaOptions>
                                    <icon>${installer.packaging}/icons/gensynth.ico</icon>
                                    <!-- A console program: no menu entries or desktop shortcuts -->
                                    <winConsole>true</winConsole>
                                    <winDirChooser>true</winDirChooser>
                                    <!-- Fixed forever, and different from the full application: both can be installed -->
                                    <winUpgradeUuid>ec511478-7dc7-476f-af1a-1184a8e17454</winUpgradeUuid>
                                    <!-- cli\gensynth.cmd runs GenSynth-CLI.exe: the folder users add to PATH -->
                                    <appContentPaths combine.children="append">
                                        <appContentPath>${installer.packaging}/windows-cli/cli</appContentPath>
                                    </appContentPaths>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>installer-linux</id>
            <activation>
                <property><name>installer</name></property>
                <os><family>unix</family><name>Linux</name></os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <configuration>
                            <icon>${installer.packaging}/icons/gensynth.png</icon>
                            <linuxPackageName>gensynth</linuxPackageName>
                            <linuxShortcut>true</linuxShortcut>
                            <linuxMenuGroup>Development</linuxMenuGroup>
                            <linuxAppCategory>devel</linuxAppCategory>
                            <!-- jpackage templates (postinst, prerm, gensynth.spec) that link /usr/bin/gensynth -->
                            <resourceDir>${installer.packaging}/linux</resourceDir>
                        </configuration>
                        <executions>
                            <execution>
                                <id>installer-deb</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <type>DEB</type>
                                    <skip>${installer.skipDeb}</skip>
                                </configuration>
                            </execution>
                            <execution>
                                <id>installer-rpm</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <type>RPM</type>
                                    <skip>${installer.skipRpm}</skip>
                                </configuration>
                            </execution>
                            <execution>
                                <id>installer-cli-deb</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <type>DEB</type>
                                    <skip>${installer.skipDeb}</skip>
                                    <name>${installer.cli.name}</name>
                                    <description>${installer.cli.description}</description>
                                    <input>${installer.cli.input}</input>
                                    <mainClass>com.gensynth.core.cli.CliMain</mainClass>
                                    <destination>${installer.cli.dist}</destination>
                                    <arguments combine.self="override"/>
                                    <launchers combine.self="override"/>
                                    <fileAssociations combine.self="override"/>
                                    <javaOptions combine.children="append">
                                        <option>-Dgensynth.edition=cli</option>
                                    </javaOptions>
                                    <linuxPackageName>gensynth-cli</linuxPackageName>
                                    <linuxShortcut>false</linuxShortcut>
                                    <!-- Without an icon jpackage adds no menu entry: it is a terminal command -->
                                    <icon combine.self="override"/>
                                    <!-- Templates that link /usr/bin/gensynth to /opt/gensynth-cli/bin/GenSynth-CLI -->
                                    <resourceDir>${installer.packaging}/linux-cli</resourceDir>
                                </configuration>
                            </execution>
                            <execution>
                                <id>installer-cli-rpm</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <type>RPM</type>
                                    <skip>${installer.skipRpm}</skip>
                                    <name>${installer.cli.name}</name>
                                    <description>${installer.cli.description}</description>
                                    <input>${installer.cli.input}</input>
                                    <mainClass>com.gensynth.core.cli.CliMain</mainClass>
                                    <destination>${installer.cli.dist}</destination>
                                    <arguments combine.self="override"/>
                                    <launchers combine.self="override"/>
                                    <fileAssociations combine.self="override"/>
                                    <javaOptions combine.children="append">
                                        <option>-Dgensynth.edition=cli</option>
                                    </javaOptions>
                                    <linuxPackageName>gensynth-cli</linuxPackageName>
                                    <linuxShortcut>false</linuxShortcut>
                                    <!-- Without an icon jpackage adds no menu entry: it is a terminal command -->
                                    <icon combine.self="override"/>
                                    <resourceDir>${installer.packaging}/linux-cli</resourceDir>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>installer-mac</id>
            <activation>
                <property><name>installer</name></property>
                <os><family>mac</family></os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>installer-dmg</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <type>DMG</type>
                                    <appVersion>${installer.macAppVersion}</appVersion>
                                    <icon>${installer.packaging}/icons/gensynth.icns</icon>
                                    <macPackageIdentifier>com.gensynth.desktop</macPackageIdentifier>
                                    <macPackageName>GenSynth</macPackageName>
                                    <!-- Shown next to the app in the disk image: how to open an unsigned app -->
                                    <macDmgContentPaths>
                                        <!-- No spaces in the name: jpackage splits this option on whitespace -->
                                        <macDmgContentPath>${installer.packaging}/macos/READ_ME_FIRST.txt</macDmgContentPath>
                                    </macDmgContentPaths>
                                </configuration>
                            </execution>
                            <execution>
                                <id>installer-cli-pkg</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <!-- A package installer: its postinstall script links /usr/local/bin/gensynth -->
                                    <type>PKG</type>
                                    <name>${installer.cli.name}</name>
                                    <description>${installer.cli.description}</description>
                                    <input>${installer.cli.input}</input>
                                    <mainClass>com.gensynth.core.cli.CliMain</mainClass>
                                    <destination>${installer.cli.dist}</destination>
                                    <arguments combine.self="override"/>
                                    <launchers combine.self="override"/>
                                    <fileAssociations combine.self="override"/>
                                    <javaOptions combine.children="append">
                                        <option>-Dgensynth.edition=cli</option>
                                    </javaOptions>
                                    <appVersion>${installer.macAppVersion}</appVersion>
                                    <icon>${installer.packaging}/icons/gensynth.icns</icon>
                                    <macPackageIdentifier>com.gensynth.cli</macPackageIdentifier>
                                    <macPackageName>GenSynth-CLI</macPackageName>
                                    <resourceDir>${installer.packaging}/macos-cli</resourceDir>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
