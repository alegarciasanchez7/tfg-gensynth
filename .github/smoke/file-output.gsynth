{
  "format": "gensynth-project",
  "version": "1.0.0",
  "groups": [{
    "id": "g1", "name": "Sensors", "enabled": true, "outputMode": "parallel",
    "flows": [{
      "id": "f1", "name": "Temperature", "technology": "file", "enabled": true, "everyTicks": 1,
      "template": "{\"n\":{{n}}}",
      "connectorConfig": { "format": "txt" }
